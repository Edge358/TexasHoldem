# Normalize line endings and protect binaries

# Auto-detect text files; handle line endings
* text=auto

# Force CRLF for common Windows/.NET text files
*.sln      text eol=crlf
*.cs       text eol=crlf
*.csproj   text eol=crlf
*.vbproj   text eol=crlf
*.fsproj   text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.resx     text eol=crlf
*.config   text eol=crlf
*.xaml     text eol=crlf
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Force LF for shell/scripts used in CI or tooling
*.sh       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# Treat these as binary (no EOL conversion/diffs)
*.dll      binary
*.exe      binary
*.pdb      binary
*.zip      binary
*.7z       binary
*.rar      binary
*.gz       binary
*.tar      binary
*.pdf      binary
*.xlsx     binary
*.xls      binary
*.pptx     binary
*.docx     binary
*.sqlite   binary
*.sqlite3  binary
*.db       binary
*.db3      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.ico      binary
