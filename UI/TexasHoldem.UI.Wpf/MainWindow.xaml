                            FontWeight="Bold"
                            Click="OnePointFivePotButton_Click" />
                    <Button x:Name="TwoXPotButton" Content="2X" Padding="16,12" Margin="0,0,8,0"
                            FontWeight="Bold"
                            Click="TwoXPotButton_Click" />
                    <Button x:Name="ThreeXPotButton" Content="3X" Padding="16,12" Margin="0,0,8,0"
                            FontWeight="Bold"
                            Click="ThreeXPotButton_Click" />
                    <Button x:Name="AllInButton" Content="ALL IN" Padding="18,12" Margin="0,0,8,0"
                            FontWeight="Bold"
                            Click="AllInButton_Click" />
                    <Button x:Name="CheckCallRightButton" Content="Check/Call" Padding="18,12" Margin="0,0,8,0"
                            FontWeight="Bold"
                            Click="CheckCallButton_Click" />
                    <Button x:Name="FoldButton" Content="Fold" Padding="18,12"
                            FontWeight="Bold"
                            Click="FoldButton_Click" />
                    <Button x:Name="NextHandButton" Content="Start Game" Padding="18,12" Margin="8,0,0,0"
                            FontWeight="Bold"
                            Tag="StartGame"
                            Click="NextHandButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="StartGame">
                                        <Setter Property="Background" Value="#FFBEE6FD" />
                                        <Setter Property="BorderBrush" Value="#FF3C7FB1" />
                                    </Trigger>
                                    <Trigger Property="Tag" Value="Highlight">
                                        <Setter Property="Background" Value="#FFBEE6FD" />
                                        <Setter Property="BorderBrush" Value="#FF3C7FB1" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
