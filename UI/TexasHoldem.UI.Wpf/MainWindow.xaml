                        <Border x:Name="Seat5CardsBorder" Canvas.Left="423" Canvas.Top="490" Style="{StaticResource CardSlotBorderStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="Seat5CardsTextBlock" Text="?? ??" Style="{StaticResource CardSlotTextStyle}" />
